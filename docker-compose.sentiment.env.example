# docker-compose.sentiment.yml 所需的环境变量
# 使用方式：cp docker-compose.sentiment.env.example .env  （放在仓库根目录，compose 会自动读取）
# 全部用 `openssl rand -hex 16` 之类生成随机值，禁止使用示例值上线。

INFLUXDB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
INFLUXDB_TOKEN=CHANGE_ME_RANDOM_TOKEN
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# 初始 admin 账号密码（首次部署自动生成，请登录后立即修改；此值仅用于新库初始化）
INITIAL_ADMIN_PASSWORD=***REMOVED***
