# 旧变体（PostgreSQL）：单阶段。基础镜像钉到 slim，依赖清单前置以利用层缓存。
FROM python:3.10-slim
WORKDIR /app

# 依赖清单与 CLI 包源码先行复制（先于其余源码），依赖层可独立缓存。
# requirements-pg.txt 末尾以 "." 安装本仓库 cli 包，故需 pyproject.toml + cli/ 一并先行。
COPY requirements-pg.txt requirements-llm.txt pyproject.toml ./
COPY cli ./cli

# psycopg2 无 binary wheel，需 gcc + libpq 头文件编译；
# 编译完成后清理编译器与 apt 缓存，保留 libpq5 运行库供 psycopg2 动态链接。
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev libpq-dev \
    && pip install --no-cache-dir -r requirements-pg.txt -r requirements-llm.txt -i https://pypi.tuna.tsinghua.edu.cn/simple \
    && apt-get purge -y gcc && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* /root/.cache/pip /tmp/*

# 复制其余源代码
COPY . .

# 非 root 运行：创建专用用户并授予日志/临时目录写权限
RUN groupadd -r appuser && useradd -r -g appuser -m appuser \
    && mkdir -p /app/logs && chown -R appuser:appuser /app
USER appuser

EXPOSE 9099

# 启动命令
CMD ["ruoyi", "app", "run", "--env=dockerpg"]
